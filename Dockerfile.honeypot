FROM python:3.12-slim
WORKDIR /app
COPY src/reverse_shell_decoy/__init__.py src/reverse_shell_decoy/signals.py src/reverse_shell_decoy/simulator.py src/reverse_shell_decoy/throttle.py src/reverse_shell_decoy/honeypot.py /app/reverse_shell_decoy/
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
ENTRYPOINT ["python", "-m", "reverse_shell_decoy.honeypot"]
# Loopback-only default. Any external bind requires explicit --allow-public.
